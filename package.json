{
  "name": "syncpoint",
  "version": "1.0.0",
  "description": "Live group travel tracking and navigation for friends on road trips (Android V1)",
  "private": true,
  "main": "index.js",
  "scripts": {
    "dev": "vite --port 5173 --host",
    "start": "react-native start",
    "android": "react-native run-android",
    "test": "node --import tsx --test tests/unit/*.test.ts",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint src/",
    "test:integration": "firebase emulators:exec --only auth,database --project demo-syncpoint \"node --import tsx --test --test-force-exit --test-concurrency=1 --test-timeout=60000 --test-reporter=spec tests/integration/*.test.ts\"",
    "check:providers": "node --import tsx scripts/check-providers.ts"
  },
  "dependencies": {
    "@firebase/auth": "^1.10.8",
    "@maplibre/maplibre-react-native": "^10.0.0",
    "@op-engineering/op-sqlite": "11.4.8",
    "@react-native-async-storage/async-storage": "^2.1.2",
    "@react-native-community/netinfo": "^11.4.1",
    "@react-navigation/native": "^7.5.0",
    "@react-navigation/native-stack": "^7.20.0",
    "firebase": "^11.4.0",
    "react": "19.0.0",
    "react-native": "0.78.0",
    "react-native-safe-area-context": "^5.3.0",
    "react-native-screens": "4.10.0",
    "react-native-svg": "^15.11.2",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@react-native-community/cli": "^20.2.0",
    "@react-native-community/cli-platform-android": "^20.2.0",
    "@react-native/babel-preset": "^0.87.1",
    "@react-native/metro-config": "^0.87.1",
    "@types/node": "^22.13.9",
    "@types/react": "^19.0.10",
    "babel-plugin-module-resolver": "^5.0.3",
    "tsx": "^4.23.15",
    "typescript": "^5.8.2",
    "vite": "^8.3.2"
  },
  "keywords": [
    "realtime-tracking",
    "group-navigation",
    "road-trip",
    "maplibre",
    "firebase-rtdb",
    "syncpoint"
  ],
  "author": "SyncPoint Team",
  "license": "UNLICENSED"
}
