# SyncPoint environment configuration.
# Copy this file to `.env` and fill in the values. `.env` is git-ignored.
# Values are inlined into the app at build time (see babel.config.js), so after
# editing `.env` restart Metro with a cleared cache:  npx react-native start --reset-cache

# --- Firebase (Console -> Project settings -> Your apps) --------------------
# Also enable Authentication -> Sign-in method -> Anonymous, and create a
# Realtime Database, then deploy database.rules.json (see docs/firebase-rules.md).
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_DATABASE_URL=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=

# --- Place search (destination + start point autocomplete) ------------------
# Two providers with automatic fallback. Leave blank to disable a provider.
GEOAPIFY_API_KEY=
LOCATIONIQ_API_KEY=

# --- Routing (car / bike / foot turn-by-turn) -------------------------------
OPENROUTESERVICE_API_KEY=

# --- Invite links -----------------------------------------------------------
# Public https origin that hosts the landing page + /join/<CODE> links,
# e.g. https://syncpoint.example.com  (no trailing slash). Leave blank until
# the domain exists: invites then fall back to sharing the code only.
INVITE_LINK_BASE_URL=

# --- Landing page (Vite) ----------------------------------------------------
VITE_GITHUB_RELEASE_URL=
